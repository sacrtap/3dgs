{
  "name": "@3dgs/plugins",
  "version": "0.1.1",
  "description": "3DGS 漫游框架插件 — 热点系统、相机控制、场景过渡、Shader 注入等领域功能",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hotspot": {
      "types": "./dist/hotspot/index.d.ts",
      "default": "./dist/hotspot/index.js"
    },
    "./camera-controls": {
      "types": "./dist/camera-controls/index.d.ts",
      "default": "./dist/camera-controls/index.js"
    },
    "./scene-transition": {
      "types": "./dist/scene-transition/index.d.ts",
      "default": "./dist/scene-transition/index.js"
    },
    "./touch-gestures": {
      "types": "./dist/touch-gestures/index.d.ts",
      "default": "./dist/touch-gestures/index.js"
    },
    "./fullscreen": {
      "types": "./dist/fullscreen/index.d.ts",
      "default": "./dist/fullscreen/index.js"
    },
    "./loading-indicator": {
      "types": "./dist/loading-indicator/index.d.ts",
      "default": "./dist/loading-indicator/index.js"
    },
    "./auto-rotate": {
      "types": "./dist/auto-rotate/index.d.ts",
      "default": "./dist/auto-rotate/index.js"
    },
    "./media-embed": {
      "types": "./dist/media-embed/index.d.ts",
      "default": "./dist/media-embed/index.js"
    },
    "./depth-occlusion": {
      "types": "./dist/depth-occlusion/index.d.ts",
      "default": "./dist/depth-occlusion/index.js"
    },
    "./shader-injection": {
      "types": "./dist/shader-injection/index.d.ts",
      "default": "./dist/shader-injection/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sacrtap/3dgs.git",
    "directory": "packages/plugins"
  },
  "homepage": "https://github.com/sacrtap/3dgs#readme",
  "bugs": {
    "url": "https://github.com/sacrtap/3dgs/issues"
  },
  "keywords": [
    "3dgs",
    "gaussian-splatting",
    "plugin",
    "hotspot",
    "touch",
    "fullscreen",
    "shader",
    "transition"
  ],
  "author": "sacrtap",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@3dgs/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
