{
  "name": "@3dgs/convert",
  "version": "0.3.0",
  "description": "3DGS 数据转换 CLI — PLY → SPLAT / SPZ / SOG 格式转换 + tour.json 模板生成",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "3dgs-convert": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sacrtap/3dgs.git",
    "directory": "packages/convert"
  },
  "homepage": "https://github.com/sacrtap/3dgs#readme",
  "bugs": {
    "url": "https://github.com/sacrtap/3dgs/issues"
  },
  "keywords": [
    "3dgs",
    "gaussian-splatting",
    "cli",
    "convert",
    "ply",
    "splat",
    "spz",
    "sog"
  ],
  "author": "sacrtap",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
