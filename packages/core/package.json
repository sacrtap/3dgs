{
  "name": "@3dgs/core",
  "version": "0.1.0",
  "description": "3DGS 渲染引擎核心 — 框架无关的 TourPlayer、SceneManager、PluginSystem",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/**/*.js", "dist/**/*.d.ts"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sacrtap/3dgs.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/sacrtap/3dgs#readme",
  "bugs": {
    "url": "https://github.com/sacrtap/3dgs/issues"
  },
  "keywords": ["3dgs", "gaussian-splatting", "3d", "renderer", "tour", "panorama", "webgl"],
  "author": "sacrtap",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
