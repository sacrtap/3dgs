{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://3dgs.dev/schema/tour-config.schema.json",
  "title": "TourConfig",
  "description": "3DGS 漫游配置 — 声明式场景图配置格式 (TourPlayer.load 输入)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scenes"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0"],
      "description": "配置版本 (当前仅支持 1.0)"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "previewImage": { "type": "string" }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "camera": { "$ref": "#/definitions/CameraSettings" },
        "transition": { "$ref": "#/definitions/SceneTransition" },
        "quality": { "$ref": "#/definitions/QualitySettings" }
      }
    },
    "scenes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/SceneConfig" }
    }
  },
  "definitions": {
    "CameraSettings": {
      "type": "object",
      "required": ["fov", "minFov", "maxFov", "limitPitch"],
      "properties": {
        "fov": { "type": "number", "minimum": 1, "maximum": 179 },
        "minFov": { "type": "number", "minimum": 1, "maximum": 179 },
        "maxFov": { "type": "number", "minimum": 1, "maximum": 179 },
        "limitPitch": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "SceneTransition": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["fade", "fly", "instant"] },
        "duration": { "type": "number", "minimum": 0 },
        "targetYaw": { "type": "number" },
        "targetPitch": { "type": "number" },
        "targetFov": { "type": "number", "minimum": 1, "maximum": 179 }
      }
    },
    "QualitySettings": {
      "type": "object",
      "properties": {
        "maxSplats": { "type": "number", "minimum": 1 },
        "shDegree": { "type": "number", "minimum": 0, "maximum": 3 },
        "resolution": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "antialias": { "type": "boolean" },
        "pixelRatio": { "type": "number", "minimum": 0.1, "maximum": 4 }
      }
    },
    "SceneConfig": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "title": { "type": "string" },
        "source": { "type": "string", "minLength": 1 },
        "lodSource": { "type": "string" },
        "initialView": {
          "type": "object",
          "properties": {
            "yaw": { "type": "number" },
            "pitch": { "type": "number" },
            "fov": { "type": "number", "minimum": 1, "maximum": 179 }
          }
        },
        "extensions": {
          "type": "object",
          "description": "通用扩展点 — 插件配置 (核心层不感知 schema)"
        },
        "overrides": {
          "type": "object",
          "properties": {
            "camera": { "$ref": "#/definitions/CameraSettings" },
            "quality": { "$ref": "#/definitions/QualitySettings" }
          }
        },
        "info": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "thumbnail": { "type": "string" }
          }
        }
      }
    }
  }
}
